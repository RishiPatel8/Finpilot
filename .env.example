# FinPilot AI Environment Configuration Example
# Copy this file to .env and adjust values for your environment

# App settings
ENVIRONMENT=development
DEBUG=True
APP_NAME="FinPilot AI"
API_V1_STR=/api/v1
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL / SQLite fallback for lightweight local dev)
# For local Docker: postgresql+psycopg://finpilot:finpilot_pass@localhost:5432/finpilot_db
# For lightweight standalone dev without Docker: sqlite+aiosqlite:///./finpilot.db or sqlite:///./finpilot.db
DATABASE_URL=sqlite:///./finpilot.db
POSTGRES_USER=finpilot
POSTGRES_PASSWORD=finpilot_pass
POSTGRES_DB=finpilot_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# AI & Cloud LLM Provider Adapter (Optional - Core finance deterministic engines work 100% offline)
# Provider choices: mock (default, offline & deterministic), gemini
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
LLM_TIMEOUT_SECONDS=15.0

# Indian Account Aggregator (AA) Bank Connectivity (Setu / Finvu / Sandbox)
# Provider choices: sandbox (default, simulated Indian banks), setu, finvu
BANK_PROVIDER=sandbox
BANK_SETU_CLIENT_ID=
BANK_SETU_CLIENT_SECRET=
BANK_SETU_PRODUCT_INSTANCE_ID=
BANK_FINVU_CLIENT_ID=
BANK_FINVU_CLIENT_SECRET=
BANK_WEBHOOK_SECRET=

# Firebase Authentication (Backend)
FIREBASE_PROJECT_ID=finpilot-8edeb
FIREBASE_CREDENTIALS_PATH=
FIREBASE_CREDENTIALS_JSON=
ALLOW_MOCK_FIREBASE=True

# Firebase Authentication (Frontend - configure in frontend/.env)
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=finpilot-8edeb.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=finpilot-8edeb
VITE_FIREBASE_STORAGE_BUCKET=finpilot-8edeb.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=699423614124
VITE_FIREBASE_APP_ID=1:699423614124:web:889748ea9437ca89d12b09
VITE_FIREBASE_MEASUREMENT_ID=G-7HRX69B6CY

# RAG & Knowledge Base
EMBEDDING_PROVIDER=mock
VECTOR_DB_DIMENSION=768
