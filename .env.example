# FinPilot AI Environment Configuration Example
# Copy this file to .env and adjust values for your environment

# App settings
ENVIRONMENT=development
DEBUG=True
APP_NAME="FinPilot AI"
API_V1_STR=/api/v1
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL / SQLite fallback for lightweight local dev)
# For local Docker: postgresql+psycopg://finpilot:finpilot_pass@localhost:5432/finpilot_db
# For lightweight standalone dev without Docker: sqlite+aiosqlite:///./finpilot.db or sqlite:///./finpilot.db
DATABASE_URL=sqlite:///./finpilot.db
POSTGRES_USER=finpilot
POSTGRES_PASSWORD=finpilot_pass
POSTGRES_DB=finpilot_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# AI & Cloud LLM Provider Adapter (Optional - Core finance deterministic engines work 100% offline)
# Provider choices: mock (default, offline & deterministic), gemini
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
LLM_TIMEOUT_SECONDS=15.0

# Indian Account Aggregator (AA) Bank Connectivity (Finvu / Setu / Sandbox)
# Provider choices: finvu (primary provider), setu (optional), sandbox (simulated offline dev)
BANK_PROVIDER=finvu
BANK_FINVU_CLIENT_ID=your_finvu_client_id
BANK_FINVU_CLIENT_SECRET=your_finvu_client_secret
BANK_FINVU_BASE_URL=https://fiu-uat.finvu.in
BANK_FINVU_FIU_ID=finpilot-fiu
BANK_FINVU_WEB_URL=https://web-uat.finvu.in
BANK_FINVU_PUBLIC_KEY=optional_finvu_rsa_public_key_pem
BANK_WEBHOOK_SECRET=your_webhook_signature_secret_or_hmac_key
BANK_REDIRECT_URL=https://confidingly-ketonic-evelina.ngrok-free.dev/bank/consent/callback

# Optional Setu Configuration (if BANK_PROVIDER=setu)
BANK_SETU_CLIENT_ID=
BANK_SETU_CLIENT_SECRET=
BANK_SETU_PRODUCT_INSTANCE_ID=

# Firebase Authentication (Backend)
FIREBASE_PROJECT_ID=finpilot-8edeb
FIREBASE_CREDENTIALS_PATH=
FIREBASE_CREDENTIALS_JSON=
ALLOW_MOCK_FIREBASE=True

# Firebase Authentication (Frontend - configure in frontend/.env)
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=finpilot-8edeb.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=finpilot-8edeb
VITE_FIREBASE_STORAGE_BUCKET=finpilot-8edeb.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=699423614124
VITE_FIREBASE_APP_ID=1:699423614124:web:889748ea9437ca89d12b09
VITE_FIREBASE_MEASUREMENT_ID=G-7HRX69B6CY

# RAG & Knowledge Base
EMBEDDING_PROVIDER=mock
VECTOR_DB_DIMENSION=768

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
TELEGRAM_BOT_USERNAME=finpilot_cfo_bot
TELEGRAM_WEBHOOK_SECRET=your_cryptographic_webhook_secret_string
TELEGRAM_WEBHOOK_URL=https://your-domain.com/api/v1/telegram/webhook
TELEGRAM_POLLING_MODE=False
